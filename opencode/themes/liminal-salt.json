{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "darkBackground": "#1a1c1b",
    "darkPanel": "#242726",
    "darkElement": "#2e312f",
    "darkBorder": "#2e312f",
    "darkText": "#e8e4dc",
    "darkTextMuted": "#9e9b93",
    "darkPrimary": "#8fac98",
    "darkSecondary": "#c5c1b8",
    "darkAccent": "#8fac98",
    "darkAccentHover": "#a3bfac",
    "darkRing": "#95bebe",
    "darkError": "#cc8585",
    "darkWarning": "#c9a86c",
    "darkSuccess": "#7dba8a",
    "darkInfo": "#95bebe",
    "darkCodeNumber": "#7eb8c9",
    "darkCodeType": "#8fb8ad",
    "darkCodeEscape": "#c9956c",
    "darkCodeRegex": "#a9ad78",
    "lightBackground": "#f5f2ed",
    "lightPanel": "#fdfcfa",
    "lightElement": "#ebe7e0",
    "lightBorder": "#ddd8d0",
    "lightText": "#2d2b28",
    "lightTextMuted": "#6b6762",
    "lightPrimary": "#506e58",
    "lightSecondary": "#5a5753",
    "lightAccent": "#506e58",
    "lightAccentHover": "#425f4a",
    "lightRing": "#3e5d5d",
    "lightError": "#a54d4d",
    "lightWarning": "#7d6325",
    "lightSuccess": "#3a7346",
    "lightInfo": "#3e5d5d",
    "lightCodeNumber": "#3a6f80",
    "lightCodeType": "#3e6b5d",
    "lightCodeEscape": "#8a5c30",
    "lightCodeRegex": "#5c6135"
  },
  "theme": {
    "primary": { "dark": "darkPrimary", "light": "lightPrimary" },
    "secondary": { "dark": "darkSecondary", "light": "lightSecondary" },
    "accent": { "dark": "darkAccent", "light": "lightAccent" },
    "error": { "dark": "darkError", "light": "lightError" },
    "warning": { "dark": "darkWarning", "light": "lightWarning" },
    "success": { "dark": "darkSuccess", "light": "lightSuccess" },
    "info": { "dark": "darkInfo", "light": "lightInfo" },
    "text": { "dark": "darkText", "light": "lightText" },
    "textMuted": { "dark": "darkTextMuted", "light": "lightTextMuted" },
    "background": { "dark": "darkBackground", "light": "lightBackground" },
    "backgroundPanel": { "dark": "darkPanel", "light": "lightPanel" },
    "backgroundElement": { "dark": "darkElement", "light": "lightElement" },
    "border": { "dark": "darkBorder", "light": "lightBorder" },
    "borderActive": { "dark": "darkRing", "light": "lightRing" },
    "borderSubtle": { "dark": "darkElement", "light": "lightElement" },
    "diffAdded": { "dark": "darkSuccess", "light": "lightSuccess" },
    "diffRemoved": { "dark": "darkError", "light": "lightError" },
    "diffContext": { "dark": "darkTextMuted", "light": "lightTextMuted" },
    "diffHunkHeader": { "dark": "darkInfo", "light": "lightInfo" },
    "diffHighlightAdded": { "dark": "darkAccentHover", "light": "lightAccentHover" },
    "diffHighlightRemoved": { "dark": "darkError", "light": "lightError" },
    "diffAddedBg": { "dark": "#384b3c", "light": "#bdccbb" },
    "diffRemovedBg": { "dark": "#4f3c3b", "light": "#ddc1bd" },
    "diffContextBg": { "dark": "darkPanel", "light": "lightPanel" },
    "diffLineNumber": { "dark": "darkTextMuted", "light": "lightTextMuted" },
    "diffAddedLineNumberBg": { "dark": "#384b3c", "light": "#bdccbb" },
    "diffRemovedLineNumberBg": { "dark": "#4f3c3b", "light": "#ddc1bd" },
    "markdownText": { "dark": "darkText", "light": "lightText" },
    "markdownHeading": { "dark": "darkAccent", "light": "lightAccent" },
    "markdownLink": { "dark": "darkPrimary", "light": "lightPrimary" },
    "markdownLinkText": { "dark": "darkAccentHover", "light": "lightAccentHover" },
    "markdownCode": { "dark": "darkSuccess", "light": "lightSuccess" },
    "markdownBlockQuote": { "dark": "darkWarning", "light": "lightWarning" },
    "markdownEmph": { "dark": "darkCodeEscape", "light": "lightCodeEscape" },
    "markdownStrong": { "dark": "darkWarning", "light": "lightWarning" },
    "markdownHorizontalRule": { "dark": "darkTextMuted", "light": "lightTextMuted" },
    "markdownListItem": { "dark": "darkPrimary", "light": "lightPrimary" },
    "markdownListEnumeration": { "dark": "darkCodeType", "light": "lightCodeType" },
    "markdownImage": { "dark": "darkPrimary", "light": "lightPrimary" },
    "markdownImageText": { "dark": "darkAccentHover", "light": "lightAccentHover" },
    "markdownCodeBlock": { "dark": "darkText", "light": "lightText" },
    "syntaxComment": { "dark": "darkTextMuted", "light": "lightTextMuted" },
    "syntaxKeyword": { "dark": "darkPrimary", "light": "lightPrimary" },
    "syntaxFunction": { "dark": "darkAccentHover", "light": "lightAccentHover" },
    "syntaxVariable": { "dark": "darkPrimary", "light": "lightPrimary" },
    "syntaxString": { "dark": "darkWarning", "light": "lightWarning" },
    "syntaxNumber": { "dark": "darkCodeNumber", "light": "lightCodeNumber" },
    "syntaxType": { "dark": "darkCodeType", "light": "lightCodeType" },
    "syntaxOperator": { "dark": "darkInfo", "light": "lightInfo" },
    "syntaxPunctuation": { "dark": "darkText", "light": "lightText" }
  }
}
