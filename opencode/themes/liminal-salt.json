{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "crust": "#1a1c1b",
    "darkGray": "#242726",
    "gray": "#2e312f",
    "lightGray": "#3d4741",
    "dimWhite": "#c5c1b8",
    "white": "#e8e4dc",
    "teal": "#8fb8ad",
    "cyan": "#95bebe",
    "blue": "#8fac98",
    "red": "#cc8585",
    "green": "#7dba8a",
    "yellow": "#c9a86c",
    "orange": "#c9956c"
  },
  "theme": {
    "primary": { "dark": "blue", "light": "blue" },
    "secondary": { "dark": "teal", "light": "teal" },
    "accent": { "dark": "cyan", "light": "cyan" },
    "error": { "dark": "red", "light": "red" },
    "warning": { "dark": "yellow", "light": "yellow" },
    "success": { "dark": "green", "light": "green" },
    "info": { "dark": "cyan", "light": "cyan" },
    "text": { "dark": "white", "light": "white" },
    "textMuted": { "dark": "dimWhite", "light": "dimWhite" },
    "background": { "dark": "crust", "light": "crust" },
    "backgroundPanel": { "dark": "darkGray", "light": "darkGray" },
    "backgroundElement": { "dark": "gray", "light": "gray" },
    "border": { "dark": "gray", "light": "gray" },
    "borderActive": { "dark": "blue", "light": "blue" },
    "borderSubtle": { "dark": "darkGray", "light": "darkGray" },
    "diffAdded": { "dark": "green", "light": "green" },
    "diffRemoved": { "dark": "red", "light": "red" },
    "diffContext": { "dark": "dimWhite", "light": "dimWhite" },
    "diffHunkHeader": { "dark": "blue", "light": "blue" },
    "diffHighlightAdded": { "dark": "green", "light": "green" },
    "diffHighlightRemoved": { "dark": "red", "light": "red" },
    "diffAddedBg": { "dark": "#384b3c", "light": "#384b3c" },
    "diffRemovedBg": { "dark": "#4f3c3b", "light": "#4f3c3b" },
    "diffContextBg": { "dark": "darkGray", "light": "darkGray" },
    "diffLineNumber": { "dark": "gray", "light": "gray" },
    "diffAddedLineNumberBg": { "dark": "#384b3c", "light": "#384b3c" },
    "diffRemovedLineNumberBg": { "dark": "#4f3c3b", "light": "#4f3c3b" },
    "markdownText": { "dark": "white", "light": "white" },
    "markdownHeading": { "dark": "cyan", "light": "cyan" },
    "markdownLink": { "dark": "teal", "light": "teal" },
    "markdownLinkText": { "dark": "blue", "light": "blue" },
    "markdownCode": { "dark": "green", "light": "green" },
    "markdownBlockQuote": { "dark": "dimWhite", "light": "dimWhite" },
    "markdownEmph": { "dark": "orange", "light": "orange" },
    "markdownStrong": { "dark": "yellow", "light": "yellow" },
    "markdownHorizontalRule": { "dark": "gray", "light": "gray" },
    "markdownListItem": { "dark": "cyan", "light": "cyan" },
    "markdownListEnumeration": { "dark": "blue", "light": "blue" },
    "markdownImage": { "dark": "teal", "light": "teal" },
    "markdownImageText": { "dark": "blue", "light": "blue" },
    "markdownCodeBlock": { "dark": "white", "light": "white" },
    "syntaxComment": { "dark": "dimWhite", "light": "dimWhite" },
    "syntaxKeyword": { "dark": "teal", "light": "teal" },
    "syntaxFunction": { "dark": "cyan", "light": "cyan" },
    "syntaxVariable": { "dark": "blue", "light": "blue" },
    "syntaxString": { "dark": "green", "light": "green" },
    "syntaxNumber": { "dark": "orange", "light": "orange" },
    "syntaxType": { "dark": "blue", "light": "blue" },
    "syntaxOperator": { "dark": "yellow", "light": "yellow" },
    "syntaxPunctuation": { "dark": "white", "light": "white" }
  }
}
